pipeline {
    agent { label 'linux-agent' }

    parameters {
        choice(name: 'ACTION', choices: ['Apply', 'Destroy'], description: 'Select the action')
    }

    stages {
        stage('Plan') {
            when {
                expression { params.ACTION == 'Apply' }
            }
            steps {
                echo 'Plan stage (sirf Apply me chalta hai)'
            }
        }

        stage('Approval') {
            steps {
                input(
                    message: "You selected ${params.ACTION}. Continue?",
                    ok: 'Proceed'
                )
            }
        }

        stage('Execute') {
            steps {
                script {
                    if (params.ACTION == 'Apply') {
                        echo 'Apply chal raha hai'
                    } else {
                        echo 'Destroy chal raha hai'
                    }
                }
            }
        }
    }

    post {
        success { echo 'Pipeline successful!' }
        failure { echo 'Pipeline failed!' }
    }
}
